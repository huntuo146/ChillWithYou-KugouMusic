<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ChillWithYou-KugouMusic-Installer</AssemblyName>
    <RootNamespace>ChillWithYou.KugouMusic.Installer</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>Chill with You - Kugou Music Bridge Installer</Product>
    <Description>Chill with You Lo-Fi Story 酷狗音乐双音源插件自动安装与更新器</Description>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="Exists('Assets\Payload.zip')">
    <EmbeddedResource Include="Assets\Payload.zip" LogicalName="ChillWithYou.KugouMusic.Installer.Assets.Payload.zip" />
  </ItemGroup>

</Project>
