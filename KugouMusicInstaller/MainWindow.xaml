<Window x:Class="ChillWithYou.KugouMusic.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chill with You · 酷狗音乐插件安装与更新器"
        Width="980"
        Height="672"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Midnight Desk Lo-Fi Tokens (aligned with KugouTheme.cs & in-game HUD) -->
        <SolidColorBrush x:Key="BgBase" Color="#0E1324"/>
        <SolidColorBrush x:Key="BgRail" Color="#A80B101E"/>
        <SolidColorBrush x:Key="BgElevated" Color="#182038"/>
        <SolidColorBrush x:Key="BgCard" Color="#B8192138"/>
        <SolidColorBrush x:Key="BgCardSoft" Color="#9613192C"/>
        <SolidColorBrush x:Key="BgInput" Color="#CC0B101F"/>
        <SolidColorBrush x:Key="StrokeHairline" Color="#24CDDEFF"/>
        <SolidColorBrush x:Key="StrokeStrong" Color="#44CDDEFF"/>
        <SolidColorBrush x:Key="StrokeDivider" Color="#18CDDEFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B4BEDA"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#7D88A8"/>
        <SolidColorBrush x:Key="AccentSky" Color="#57C7FF"/>
        <SolidColorBrush x:Key="AccentLavender" Color="#8E7CFF"/>
        <SolidColorBrush x:Key="AccentCoral" Color="#FF6F9E"/>
        <SolidColorBrush x:Key="StatusOk" Color="#4CE0B3"/>
        <SolidColorBrush x:Key="StatusWarn" Color="#FFB86C"/>
        <SolidColorBrush x:Key="StatusErr" Color="#FF6B7A"/>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#57C7FF" Offset="0"/>
            <GradientStop Color="#8E7CFF" Offset="0.56"/>
            <GradientStop Color="#FF6F9E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBtnGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4EC4FF" Offset="0"/>
            <GradientStop Color="#8A76FF" Offset="0.65"/>
            <GradientStop Color="#B875FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopShimmerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0057C7FF" Offset="0"/>
            <GradientStop Color="#7757C7FF" Offset="0.28"/>
            <GradientStop Color="#888E7CFF" Offset="0.54"/>
            <GradientStop Color="#66FF6F9E" Offset="0.78"/>
            <GradientStop Color="#00FF6F9E" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="VinylPlatterBrush" GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#273154" Offset="0"/>
            <GradientStop Color="#141A30" Offset="0.58"/>
            <GradientStop Color="#0B0F1E" Offset="1"/>
        </RadialGradientBrush>

        <!-- Implicit Slim Dark ScrollBar -->
        <Style x:Key="SlimScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBd" Background="#32CDDEFF" CornerRadius="3" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#5CCDE0FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#888E7CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Glass Card Surface -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>

        <!-- Single-Line DarkTextBox (ZERO vertical clipping across all DPIs) -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentSky}"/>
            <Setter Property="SelectionBrush" Value="#668E7CFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLavender}"/>
                                <Setter TargetName="bd" Property="Background" Value="#E60E1426"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Multiline Console Log TextBox -->
        <Style x:Key="LogTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#D8090D1A"/>
            <Setter Property="Foreground" Value="#96A3C4"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="2">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A8E7CFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A8E7CFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{StaticResource BgInput}"
                                BorderBrush="{StaticResource StrokeHairline}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Data="M0,0 L4.5,4.5 L9,0"
                                      Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLavender}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleButton}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="11,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#F5141B30"
                                        BorderBrush="{StaticResource StrokeStrong}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="2,4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glowing Lo-Fi ProgressBar (Determinate + Smooth Indeterminate Sweep) -->
        <Style x:Key="LofiProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#16CDDEFF"/>
            <Setter Property="Foreground" Value="{StaticResource BrandGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3.5"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3.5"/>
                            <Border x:Name="IndetOverlay"
                                    CornerRadius="3.5"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1"/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="#0057C7FF" Offset="0.0"/>
                                        <GradientStop Color="#DD57C7FF" Offset="0.28"/>
                                        <GradientStop Color="#FF8E7CFF" Offset="0.52"/>
                                        <GradientStop Color="#DDFF6F9E" Offset="0.74"/>
                                        <GradientStop Color="#00FF6F9E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IndetOverlay" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndetStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndetOverlay"
                                                             Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)"
                                                             From="-1.0" To="1.0" Duration="0:0:1.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndetStoryboard"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Luminous CTA Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{StaticResource PrimaryBtnGradient}"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#8E7CFF" Opacity="0.38"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.93"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Glass Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#222A44"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D3759"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D243C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Header Pill Button -->
        <Style x:Key="GhostPillButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#14CDDEFF"/>
            <Setter Property="BorderBrush" Value="#26CDDEFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- Danger Ghost Button -->
        <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FF95A2"/>
            <Setter Property="Background" Value="#1AFF6B7A"/>
            <Setter Property="BorderBrush" Value="#48FF6B7A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30FF6B7A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#88FF6B7A"/>
                                <Setter Property="Foreground" Value="#FFB8C1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FF6B7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Chrome Buttons -->
        <Style x:Key="TitleChromeButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#48FF6B7A"/>
                                <Setter Property="Foreground" Value="#FFD2D8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refined Dark CheckBox -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4.5"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="chk" Data="M3,8.2 L6.4,11.6 L12.8,4.6"
                                      Stroke="White" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentSky}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#8E7CFF"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#B0A3FF"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Source Selector Card RadioButton -->
        <Style x:Key="DarkRadioTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{StaticResource BgInput}"
                                BorderBrush="{StaticResource StrokeHairline}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="dotOuter" Grid.Column="0" Width="15" Height="15" CornerRadius="7.5"
                                        BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1.5"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Ellipse x:Name="dotInner" Width="7" Height="7" Fill="{StaticResource AccentSky}" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#248E7CFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8E7CFF"/>
                                <Setter TargetName="dotOuter" Property="BorderBrush" Value="{StaticResource AccentSky}"/>
                                <Setter TargetName="dotInner" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Floating Glass Window Shell -->
    <Border Margin="12" CornerRadius="18" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1222" Offset="0"/>
                <GradientStop Color="#141C32" Offset="0.52"/>
                <GradientStop Color="#101526" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#000000" Opacity="0.72"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <!-- Clipped Ambient Lo-Fi Twilight Glow Layers (pure vector gradients, zero external assets) -->
            <Border Grid.RowSpan="3" CornerRadius="18" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.10,0.08" GradientOrigin="0.10,0.08" RadiusX="0.45" RadiusY="0.55">
                        <GradientStop Color="#2257C7FF" Offset="0"/>
                        <GradientStop Color="#0057C7FF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border Grid.RowSpan="3" CornerRadius="18" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.92,0.92" GradientOrigin="0.92,0.92" RadiusX="0.46" RadiusY="0.50">
                        <GradientStop Color="#1C8E7CFF" Offset="0"/>
                        <GradientStop Color="#0AFF6F9E" Offset="0.45"/>
                        <GradientStop Color="#00FF6F9E" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Top Luminous Hairline Shimmer -->
            <Border Grid.Row="0" Height="1.5" VerticalAlignment="Top" Margin="28,0" Background="{StaticResource TopShimmerGradient}" IsHitTestVisible="False"/>

            <!-- Row 0: Custom Draggable Title Bar -->
            <Border Grid.Row="0" Background="#5C0B101E" CornerRadius="18,18,0,0" BorderBrush="{StaticResource StrokeDivider}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrandGradient}" Margin="0,0,11,0">
                            <TextBlock Text="♪" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <TextBlock Text="Chill with You" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="·" Foreground="{StaticResource AccentSky}" FontSize="15" FontWeight="Bold" Margin="7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="酷狗音乐插件安装中心" Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                        <Border Background="#1C57C7FF" BorderBrush="#4257C7FF" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderVersion" Text="v1.0.0" Foreground="{StaticResource AccentSky}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnShowNotice" Content="守则与致谢" Style="{StaticResource GhostPillButton}" Margin="0,0,10,0" Click="BtnShowNotice_Click"/>
                        <Button Content="—" Style="{StaticResource TitleChromeButton}" Click="BtnMinimize_Click" Margin="0,0,3,0"/>
                        <Button Content="✕" Style="{StaticResource TitleCloseButton}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Two-Column Asymmetric Studio Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Studio Rail: Vinyl Hero + Diagnostic Telemetry -->
                <Border Grid.Column="0" Background="{StaticResource BgRail}" BorderBrush="{StaticResource StrokeDivider}" BorderThickness="0,0,1,0" Padding="18,16,18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hero Vinyl / Lo-Fi Pomodoro Orbital Emblem -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,2,0,14">
                            <Grid Width="98" Height="98" HorizontalAlignment="Center">
                                <Ellipse Width="120" Height="120" Margin="-11" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#368E7CFF" Offset="0"/>
                                            <GradientStop Color="#1257C7FF" Offset="0.55"/>
                                            <GradientStop Color="#0057C7FF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- Outer Pomodoro Gradient Ring -->
                                <Ellipse Width="94" Height="94" Stroke="{StaticResource BrandGradient}" StrokeThickness="2.6"/>
                                <!-- Vinyl Disc -->
                                <Ellipse Width="82" Height="82" Fill="{StaticResource VinylPlatterBrush}" Stroke="#22FFFFFF" StrokeThickness="1"/>
                                <Ellipse Width="66" Height="66" Stroke="#16FFFFFF" StrokeThickness="1"/>
                                <Ellipse Width="52" Height="52" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                <!-- Center Spindle Label -->
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandGradient}">
                                    <TextBlock Text="♪" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Border>
                                <!-- Warm Desk-Lamp Indicator Dot -->
                                <Ellipse Width="7" Height="7" Fill="{StaticResource StatusWarn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,11,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFB86C" Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>

                            <TextBlock Text="MIDNIGHT DESK · AUDIO MOD" Foreground="{StaticResource TextTertiary}" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,5"/>
                            <Border Background="#181F36" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="10" Padding="10,3.5" HorizontalAlignment="Center" MaxWidth="226">
                                <TextBlock x:Name="TxtScanSource" Text="正在扫描游戏环境..." Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Rail Section Divider -->
                        <Grid Grid.Row="1" Margin="2,0,2,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="{StaticResource AccentSky}" Margin="0,0,7,0"/>
                                <TextBlock Text="环境状态检测" Foreground="{StaticResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="1" Background="{StaticResource StrokeDivider}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Structured Vertical Telemetry Stack (all 5 Chip* & TxtChip* preserved) -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Top">
                            <Border x:Name="ChipGame" Background="#14192E" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="9" Padding="11,7.5" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6.5" Height="6.5" Fill="{Binding Foreground, ElementName=TxtChipGame}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtChipGame" Grid.Column="1" Text="游戏本体: 待检测" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ChipBepInEx" Background="#14192E" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="9" Padding="11,7.5" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6.5" Height="6.5" Fill="{Binding Foreground, ElementName=TxtChipBepInEx}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtChipBepInEx" Grid.Column="1" Text="BepInEx 5: 待检测" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ChipPlugin" Background="#14192E" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="9" Padding="11,7.5" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6.5" Height="6.5" Fill="{Binding Foreground, ElementName=TxtChipPlugin}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtChipPlugin" Grid.Column="1" Text="酷狗插件: 待检测" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ChipGateway" Background="#14192E" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="9" Padding="11,7.5" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6.5" Height="6.5" Fill="{Binding Foreground, ElementName=TxtChipGateway}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtChipGateway" Grid.Column="1" Text="本地网关: 待检测" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ChipNode" Background="#14192E" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="9" Padding="11,7.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6.5" Height="6.5" Fill="{Binding Foreground, ElementName=TxtChipNode}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="TxtChipNode" Grid.Column="1" Text="Node.js: 待检测" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Quiet Rail Footer Caption -->
                        <Border Grid.Row="3" Background="#0F1426" BorderBrush="{StaticResource StrokeDivider}" BorderThickness="1" CornerRadius="9" Padding="11,8" Margin="0,10,0,0">
                            <TextBlock Text="支持自动识别 Steam 路径 · 保留个人歌单与账号配置 · 支持一键无痕卸载"
                                       Foreground="{StaticResource TextTertiary}" FontSize="10.8" LineHeight="16.5" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Main Workspace -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14,20,12">
                    <StackPanel>

                        <!-- Card 1: Game Directory -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,11">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="13" CornerRadius="1.5" Background="{StaticResource AccentSky}" Margin="0,0,8,0"/>
                                        <TextBlock Text="游戏根目录定位" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="需包含 Chill With You.exe" Foreground="{StaticResource TextTertiary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtGameDir" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                             TextChanged="TxtGameDir_TextChanged"/>
                                    <Button Grid.Column="1" Content="重新扫描" Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0" Click="BtnRescan_Click"/>
                                    <Button Grid.Column="2" Content="浏览目录" Style="{StaticResource SecondaryButton}" Height="38" Margin="6,0,0,0" Click="BtnBrowse_Click"/>
                                </Grid>

                                <!-- Multi-Candidate Selector (Styled Dark ComboBox) -->
                                <Grid x:Name="PanelMultiCandidates" Margin="0,9,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="切换检测到的目录：" Foreground="{StaticResource TextTertiary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbCandidates" Grid.Column="1" Style="{StaticResource DarkComboBox}" HorizontalAlignment="Stretch"
                                              SelectionChanged="CmbCandidates_SelectionChanged"/>
                                </Grid>

                                <!-- Game Running Warning Strip -->
                                <Border x:Name="PanelRunningWarn" Background="#1FFFB86C" BorderBrush="#62FFB86C" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,9,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="检测到 Chill With You.exe 正在运行，安装或覆盖更新前请先关闭游戏以避免文件占用。"
                                                   Foreground="{StaticResource StatusWarn}" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <Button Grid.Column="1" Content="关闭游戏进程" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,0" FontSize="11.5" VerticalAlignment="Center" Click="BtnKillGame_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Package Source & Options -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,11">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="13" CornerRadius="1.5" Background="{StaticResource AccentLavender}" Margin="0,0,8,0"/>
                                        <TextBlock Text="安装源与依赖组件" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="支持离线完整包或 GitHub 在线热更" Foreground="{StaticResource TextTertiary}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Segmented Radio Cards -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton x:Name="RbSourceOffline" Grid.Column="0" Style="{StaticResource DarkRadioTab}" GroupName="InstallSource" IsChecked="True"
                                                 Checked="InstallSource_Changed">
                                        <StackPanel>
                                            <TextBlock Text="内置完整离线包" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="内嵌全部依赖 · 无需联网即可部署" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="RbSourceGitHub" Grid.Column="2" Style="{StaticResource DarkRadioTab}" GroupName="InstallSource"
                                                 Checked="InstallSource_Changed">
                                        <StackPanel>
                                            <TextBlock Text="GitHub Releases 在线版" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="直连官方发布页 · 自动拉取最新版本" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <!-- GitHub Repo Input -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="GitHub 仓库" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="TxtGitHubRepo" Style="{StaticResource DarkTextBox}" TextChanged="TxtGitHubRepo_TextChanged"/>
                                        <TextBlock x:Name="TxtRepoPlaceholder" Text="输入 owner/repo 或完整链接（自动同步至游戏内设置）"
                                                   Foreground="{StaticResource TextTertiary}" FontSize="11.5" VerticalAlignment="Center" Margin="13,0,12,0"
                                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Button x:Name="BtnCheckGitHub" Grid.Column="2" Content="检查更新" Style="{StaticResource SecondaryButton}" Height="38" Margin="8,0,0,0" Click="BtnCheckGitHub_Click"/>
                                </Grid>

                                <!-- GitHub Release Status Banner -->
                                <Border x:Name="PanelGitHubStatus" Background="{StaticResource BgCardSoft}" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,9,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtReleaseHeadline" Text="" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtReleaseNotes" Text="" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="BtnOpenRelease" Grid.Column="1" Content="打开发布页" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,0" FontSize="11.5" VerticalAlignment="Center" Click="BtnOpenRelease_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Subtle Divider -->
                                <Border Height="1" Background="{StaticResource StrokeDivider}" Margin="0,12,0,8"/>

                                <!-- Options Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox x:Name="ChkInstallGateway" Style="{StaticResource DarkCheckBox}" IsChecked="True"
                                                  Content="安装 / 更新本地网关 KuGouMusicApi"/>
                                        <CheckBox x:Name="ChkAutoNode" Style="{StaticResource DarkCheckBox}" IsChecked="True"
                                                  Content="缺少 Node.js 时自动下载便携版"/>
                                        <CheckBox x:Name="ChkKeepInstaller" Style="{StaticResource DarkCheckBox}" IsChecked="False"
                                                  Content="在游戏目录保留安装器副本"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox x:Name="ChkPreserveConfig" Style="{StaticResource DarkCheckBox}" IsChecked="True"
                                                  Content="保留现有 Cookie、歌单与界面配置"/>
                                        <CheckBox x:Name="ChkLaunchAfter" Style="{StaticResource DarkCheckBox}" IsChecked="True"
                                                  Content="安装完成后自动启动游戏"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Collapsible Inline Uninstall Confirm Panel -->
                        <Border x:Name="PanelUninstallConfirm" Background="#1DFF6B7A" BorderBrush="#58FF6B7A" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,11" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="确认卸载酷狗音乐插件？默认仅移除插件主文件，保留你的歌单、账号配置与 BepInEx 框架。"
                                           Foreground="#FFC2CA" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,6,0,8">
                                    <CheckBox x:Name="ChkUninstGateway" Style="{StaticResource DarkCheckBox}" Content="同时移除 KuGouMusicApi 网关" Margin="0,2,16,2"/>
                                    <CheckBox x:Name="ChkUninstBepInEx" Style="{StaticResource DarkCheckBox}" Content="同时移除 BepInEx 框架与 Doorstop" Margin="0,2,16,2"/>
                                    <CheckBox x:Name="ChkUninstData" Style="{StaticResource DarkCheckBox}" Content="清理歌单 / 账号与音频缓存" Margin="0,2,0,2"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="取消" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="14,0" Margin="0,0,8,0" Click="BtnCancelUninstall_Click"/>
                                    <Button Content="确认卸载" Style="{StaticResource DangerGhostButton}" MinHeight="30" Padding="16,0" Click="BtnConfirmUninstall_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Live Progress & Console Log -->
                        <Border Style="{StaticResource CardBorder}" Padding="16,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtProgressStatus" Grid.Column="0"
                                               Text="就绪：确认游戏根目录后，点击右下角按钮开始部署。"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text=""
                                               Foreground="{StaticResource AccentSky}" FontSize="12" FontWeight="Bold"/>
                                </Grid>

                                <ProgressBar x:Name="ProgressBarMain" Style="{StaticResource LofiProgressBar}"
                                             Minimum="0" Maximum="100" Value="0"/>

                                <TextBox x:Name="TxtLog" Style="{StaticResource LogTextBox}" Height="72" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Row 2: Anchored Bottom Action Bar -->
            <Border Grid.Row="2" Background="#6C0B101E" CornerRadius="0,0,18,18" BorderBrush="{StaticResource StrokeDivider}" BorderThickness="0,1,0,0" Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnUninstallToggle" Grid.Column="0" Content="卸载插件" Style="{StaticResource DangerGhostButton}" Height="38" Click="BtnUninstallToggle_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnOpenFolder" Content="打开目录" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
                        <Button x:Name="BtnLaunchGame" Content="启动游戏" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,12,0" Click="BtnLaunchGame_Click"/>
                        <Button x:Name="BtnInstall" Content="一键安装 / 更新" Style="{StaticResource PrimaryButton}" MinWidth="168" Height="38" Click="BtnInstall_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pre-Install Notice Modal Overlay (Covers Rows 1-2; Title Bar stays interactive) -->
            <Border x:Name="PanelPreInstallNotice" Grid.Row="1" Grid.RowSpan="2" Background="#EE080C18" CornerRadius="0,0,18,18" Padding="32,20" Visibility="Visible">
                <Border Background="#F5151C32" BorderBrush="#4E8E7CFF" BorderThickness="1" CornerRadius="16" Padding="24,20" MaxWidth="780" MaxHeight="556" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Color="#000000" Opacity="0.78"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Modal Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BrandGradient}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="安装前须知" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="开源构建说明 · 版权声明 · 免责条款" Foreground="{StaticResource TextPrimary}" FontSize="15.5" FontWeight="Bold"/>
                                <TextBlock Text="请先阅读以下说明与条款，确认后再进入安装流程" Foreground="{StaticResource TextTertiary}" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Modal Scrollable Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                <!-- Section 1: Open Source Stack -->
                                <Border Background="#C00E1324" BorderBrush="{StaticResource StrokeHairline}" BorderThickness="1" CornerRadius="11" Margin="0,0,0,12" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{StaticResource AccentSky}" Margin="0,2,12,2"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="一、技术栈与开源项目致谢" Foreground="#8CD9FF" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" LineHeight="21" TextWrapping="Wrap">
                                                • 本插件专为桌面伴侣游戏《Chill with You Lo-Fi Story》构建，属于非官方第三方扩展，与游戏开发商无任何隶属或合作关系。<LineBreak/>
                                                • 运行期注入框架基于开源项目 <Run FontWeight="SemiBold" Foreground="#EEF2FF">BepInEx 5 (5.4.23.x)</Run>、<Run FontWeight="SemiBold" Foreground="#EEF2FF">UnityDoorstop</Run> 与 <Run FontWeight="SemiBold" Foreground="#EEF2FF">HarmonyX</Run> 实现。<LineBreak/>
                                                • 酷狗音源与本地网关协议基于开源项目 <Run FontWeight="SemiBold" Foreground="#EEF2FF">MakcRe/KuGouMusicApi (MIT License)</Run> 及 <Run FontWeight="SemiBold" Foreground="#EEF2FF">Node.js</Run> 构建；联动 <Run FontWeight="SemiBold" Foreground="#EEF2FF">Newtonsoft.Json</Run> 与 <Run FontWeight="SemiBold" Foreground="#EEF2FF">UniTask</Run> 运行。
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Section 2: Disclaimer -->
                                <Border Background="#C00E1324" BorderBrush="#48FFB86C" BorderThickness="1" CornerRadius="11" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="{StaticResource StatusWarn}" Margin="0,2,12,2"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="二、使用守则与免责声明" Foreground="{StaticResource StatusWarn}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" LineHeight="21.5" TextWrapping="Wrap">
                                                <Run FontWeight="SemiBold" Foreground="#EEF2FF">1. 仅供个人学习与单机休闲娱乐使用：</Run>严禁将本插件用于任何商业用途、倒卖分发、违法违规活动或绕过付费版权校验。<LineBreak/>
                                                <Run FontWeight="SemiBold" Foreground="#EEF2FF">2. 音乐版权归属于酷狗音乐：</Run>通过本插件检索、播放或缓存的全部音频、歌词、封面及相关数据，其版权与合法权益均完全归属于<Run FontWeight="SemiBold" Foreground="#EEF2FF">酷狗音乐（KuGou Music）</Run>及原词曲/唱片版权方。请尊重正版，支持官方平台。<LineBreak/>
                                                <Run FontWeight="SemiBold" Foreground="#EEF2FF">3. 账号风险与完全免责：</Run>通过本插件使用扫码登录、Cookie 鉴权、VIP 权益领取或高频请求接口均可能触发平台风控策略。<Run FontWeight="SemiBold" Foreground="#FF9AA6">因使用本插件导致酷狗音乐账号被限流、冻结或封禁等任何后果，均与本插件及关联开源项目无关</Run>，由使用者自行承担全部责任与损失。<LineBreak/>
                                                <Run FontWeight="SemiBold" Foreground="#4CE0B3">4. 默认同意条款：</Run>点击下方「同意」按钮、安装或继续使用本插件，即视为您已完整阅读并<Run FontWeight="SemiBold" Foreground="#EEF2FF">默认同意遵守以上全部守则与免责声明</Run>；请勿在公开直播或非授权场景传播使用。
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Modal Footer (Strict 2-Column Grid — Zero Collision Guaranteed) -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource StrokeDivider}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="提示：安装全程免费且开源，建议仅从官方 GitHub 发布页获取。"
                                           Foreground="{StaticResource TextTertiary}" FontSize="11.5"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnDeclineNotice" Content="不同意并退出" Style="{StaticResource DangerGhostButton}" Height="38" Margin="0,0,10,0" Click="BtnDeclineNotice_Click"/>
                                    <Button x:Name="BtnAcceptNotice" Content="我已阅读并同意，进入安装" Style="{StaticResource PrimaryButton}" Height="38" Click="BtnAcceptNotice_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
